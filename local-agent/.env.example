# ── Local Docker Execution Agent Environment Variables ───────────────────────
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Secret shared between this agent and the Remote MCP Server.
# Must match LOCAL_AGENT_SECRET in mcp-server/.env
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOCAL_AGENT_SECRET=REPLACE_WITH_SAME_KEY_AS_MCP_SERVER

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# Port for the local agent HTTP server. Default: 4000
LOCAL_AGENT_PORT=4000

# Semicolon-separated list of absolute paths the agent is allowed to access.
# Leave empty to allow any path (not recommended for shared machines).
# Example: C:\Users\user\Downloads\student-management-system-main\student-management-system-main
ALLOWED_PROJECT_DIRS=C:\Users\user\Downloads\student-management-system-main\student-management-system-main

# Docker host (usually not needed on Windows with Docker Desktop)
# Windows: npipe:////./pipe/docker_engine
# Linux/Mac: unix:///var/run/docker.sock
# DOCKER_HOST=npipe:////./pipe/docker_engine
