# Vercel API Token
# Get from: https://vercel.com/account/tokens → Create Token
VERCEL_API_TOKEN=your_vercel_token_here

# Render API Key
# Get from: https://dashboard.render.com/u/settings#api-keys → Create API Key
RENDER_API_KEY=your_render_api_key_here

# MCP Server Port (default: 3001)
MCP_PORT=3001

