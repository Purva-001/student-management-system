# Environment Variables for MCP Server

# URL of the existing backend
BACKEND_API_URL=https://student-management-system-iqki.onrender.com

# Secret token used to authenticate Devin (and any other MCP clients)
# Generate a strong random value: openssl rand -hex 32
# Example: 44dcbb95755edbfa40c2c3d2f1c348514015d750a566594c0c5928987ca6eecf
MCP_API_KEY=your-strong-random-secret-here

# Port the MCP server listens on (Render injects this automatically)
PORT=3001
